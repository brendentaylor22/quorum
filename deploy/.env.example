# Production must use exact GHCR digest, never a floating tag.
QUORUM_IMAGE=ghcr.io/brendentaylor22/quorum@sha256:REPLACE_WITH_APPROVED_DIGEST
QUORUM_DATA_VOLUME=quorum-data

# --- Ingress ---------------------------------------------------------------
# Pick one shape: `quorumctl start --proxy` or `quorumctl start --tunnel`.
# The app publishes no port either way and has no route to the Internet.

# Required by the proxy profile. Must resolve to this host, with 80 and 443
# reaching it, or no certificate can be issued.
#QUORUM_PUBLIC_HOSTNAME=quorum.example.org
#QUORUM_ACME_EMAIL=you@example.org

# Whose X-Forwarded-For to believe. Unset means nobody's, which is correct only
# with nothing in front. Behind either ingress shape this must be set, or every
# caller shares one rate-limit bucket. Prefer naming the proxy over `true`.
#QUORUM_TRUST_PROXY=172.16.0.0/12

# --- Tuning ----------------------------------------------------------------
# Multiplies every rate limit. 1 is the documented policy; raise it for a large
# shared address. 0 disables limiting and is only defensible on a trusted
# private network.
#QUORUM_RATE_LIMIT_SCALE=1
#QUORUM_RETENTION_SWEEP_MINUTES=15
